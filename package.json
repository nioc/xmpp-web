{
  "name": "xmpp-web",
  "version": "0.12.0",
  "private": true,
  "description": "Lightweight web chat client for XMPP server",
  "homepage": "https://github.com/nioc/xmpp-web",
  "bugs": {
    "url": "https://github.com/nioc/xmpp-web/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nioc/xmpp-web.git"
  },
  "author": "nioc <dev@nioc.eu>",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite build && vite preview --port 3000",
    "configure-git-hook": "cp docs/git-hooks/commit-msg .git/hooks/",
    "cy:open-e2e": "cypress open --e2e --config baseUrl=https://localhost:3000/ --browser electron",
    "cy:run-e2e-dev": "cypress run --e2e --config baseUrl=https://localhost:3000/",
    "cy:run-e2e-preview": "cypress run --e2e --config baseUrl=http://localhost:3000/",
    "test:dev": "start-server-and-test dev https://localhost:3000 cy:run-e2e-dev",
    "test:preview": "start-server-and-test preview https://localhost:3000 cy:run-e2e-preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs  --ignore-path .gitignore --ignore-pattern 'docs/*'",
    "lint-fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore --ignore-pattern 'docs/*'"
  },
  "xmppWeb": {
    "latestReleaseUrl": "https://api.github.com/repos/nioc/xmpp-web/releases/latest"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@creativebulma/bulma-divider": "^1.1.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@oruga-ui/oruga-next": "^0.5.10",
    "@oruga-ui/theme-bulma": "^0.2.11",
    "@vueuse/core": "^14.2.1",
    "@xmpp/client": "^0.14.0",
    "@xmpp/debug": "^0.14.0",
    "@xmpp/error": "^0.14.0",
    "axios": "^1.13.6",
    "bulma": "^0.9.4",
    "dayjs": "^1.11.19",
    "filesize": "^11.0.13",
    "gemoji": "^8.1.0",
    "mime": "^4.1.0",
    "nanoid": "^5.1.6",
    "pinia": "^3.0.4",
    "sanitize-html": "^2.17.1",
    "spdx-license-list": "^6.11.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.1",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "cypress": "^15.11.0",
    "cypress-real-events": "^1.15.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "mock-socket": "^9.3.1",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^7.0.0",
    "sass": "^1.97.3",
    "start-server-and-test": "^2.1.5",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-mkcert": "^1.17.10",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}